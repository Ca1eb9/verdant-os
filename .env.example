# ──────────────────────────────────────────
# MQTT
# ──────────────────────────────────────────
BROKER_URL=mqtt://localhost:1883

# ──────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────
# Database (local)
# ──────────────────────────────────────────
DB_PATH=./farm_telemetry.db

# ──────────────────────────────────────────
# Farm
# ──────────────────────────────────────────
TOPOLOGY_PATH=../../topology.json
ROBOT_ID=robot-1

# ──────────────────────────────────────────
# Dashboard: copy into web/.env.local (Next only reads env files in web/)
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# On the farm network only; leave these unset on Vercel.
# The broker's WebSocket listener (farm-controller/README.md)
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
# This Pi's farm: its row in Supabase's farms table. Lowercase letters,
# digits and dashes.
NEXT_PUBLIC_FARM_ID=
NEXT_PUBLIC_FARM_NAME=