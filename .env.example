# ──────────────────────────────────────────
# MQTT
# ──────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883

# ──────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ──────────────────────────────────────────
# Database (local)
# ──────────────────────────────────────────
DB_PATH=./farm_telemetry.db

# ──────────────────────────────────────────
# Farm
# ──────────────────────────────────────────
TOPOLOGY_PATH=../../topology.json
ROBOT_ID=robot-1

# ──────────────────────────────────────────
# Dashboard (Vercel)
# ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
# Operator sign-in (Supabase Auth). The web app reads SUPABASE_URL and
# SUPABASE_ANON_KEY above on the server; the key is never sent to the browser.
# Set AUTH_DISABLED=true ONLY on the farm Pi (LAN access, works offline).
# Never set it on Vercel.
AUTH_DISABLED=
