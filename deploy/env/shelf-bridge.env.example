# Copy to /etc/verdant/shelf-bridge.env (docs/PI-SERVICES.md).
BROKER_URL=mqtt://localhost:1883
# Open silence alerts, kept outside the repo so a deploy never touches them
STATE_PATH=/var/lib/verdant/shelf-bridge-state.json
# This Pi's serial ports and pH calibration, copied from the repo's
# farm-controller/shelf-bridge-config.json and kept outside it, so a deploy
# never touches them
CONFIG_PATH=/etc/verdant/shelf-bridge-config.json
