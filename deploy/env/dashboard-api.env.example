# Copy to /etc/verdant/dashboard-api.env (docs/PI-SERVICES.md).
PORT=3001
# The ingester's database (its DB_PATH), opened read-only
DB_PATH=/var/lib/verdant/farm_telemetry.db
# Where the dashboard is opened from: browsers only let these pages call the API.
# The Pi serves it on port 80, so its origins carry no port; localhost:3000 is
# npm run dev.
CORS_ORIGINS=http://farmnet.local,http://farmnet,http://192.168.4.1,http://localhost:3000
