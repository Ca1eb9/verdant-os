# Copy to /etc/verdant/dashboard.env and fill in (docs/PI-SERVICES.md).
# Secrets: this file is root:farm 640 and never committed.
# The deploy script reads it with bash: quote values with spaces ("North Farm").
# No OPERATOR_KEY: on FarmNet the dashboard sends commands straight over MQTT.

# NEXT_PUBLIC_* values are fixed when the dashboard is built; the deploy script
# builds with this file. The dashboard finds the broker on its own: opened from
# the Pi (http), it connects to port 9001 on the same host (docs/WIFI-SETUP.md).
# This Pi's farm: the same id and name as its row in Supabase's farms table
# (docs/SUPABASE-SETUP.md). Lowercase letters, digits and dashes. It also turns
# off operator sign-in, so the dashboard works offline.
NEXT_PUBLIC_FARM_ID=
NEXT_PUBLIC_FARM_NAME=
# The Dashboard API (farm-dashboard-api): command history and other stored data
# on FarmNet. Its PORT in /etc/verdant/dashboard-api.env.
NEXT_PUBLIC_DASHBOARD_API_URL=http://192.168.4.1:3001
# true: offer jog before a robot has read its first tag (initializing), e.g.
# to drive it onto one. Off unless set.
NEXT_PUBLIC_JOG_WHILE_INITIALIZING=false
# Shows "Elevator arrived" while a robot is on the elevator, for robots flashed
# with MANUAL_ELEVATOR (firmware config.h, on by default), which wait on the
# elevator for that button instead of a fixed time. false only with robots
# flashed with it off. On unless set to false.
NEXT_PUBLIC_MANUAL_ELEVATOR=true
# The farm map draws the grow lights from the Lights card's switches. false
# draws them from the light sensors instead, as bright as they read. A level
# without its own switch follows whether any light is on. On unless set to false.
NEXT_PUBLIC_MAP_LIGHTS_FROM_SWITCHES=true
# true: the farm map draws each light simply on (at 2000 lux or more on its
# sensor) or off, instead of as bright as it reads. Only when the map draws
# from the sensors (the switches option above false). Off unless set.
NEXT_PUBLIC_MAP_LIGHTS_ON_OFF=false

# Supabase (history and remote mode). Server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=
