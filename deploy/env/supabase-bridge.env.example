# Copy to /etc/verdant/supabase-bridge.env (docs/PI-SERVICES.md), then fill in
# the three Supabase values (docs/SUPABASE-SETUP.md, step 5).
BROKER_URL=mqtt://localhost:1883
# Project Settings → Data API
SUPABASE_URL=
# Project Settings → API Keys: the secret key (sb_secret_…, or the legacy
# service_role key), never the publishable one. It bypasses RLS: keep it on
# the Pi, never in git or chat.
SUPABASE_SERVICE_ROLE_KEY=
# This farm's id in Supabase's farms table (the same as NEXT_PUBLIC_FARM_ID in
# dashboard.env). The bridge stops at startup if the row doesn't exist.
FARM_ID=
# Default: the repo's farm-controller/supabase-bridge-config.json
#CONFIG_PATH=
