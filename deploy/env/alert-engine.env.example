# Copy to /etc/verdant/alert-engine.env (docs/PI-SERVICES.md).
BROKER_URL=mqtt://localhost:1883
# Default: the repo's farm-controller/alert-engine-config.json
#CONFIG_PATH=

# Optional: email every critical alert, from any service, through Resend
# (resend.com). Email stays off, with a warning in the log, unless all three
# are set. Until you verify a domain in Resend, send from onboarding@resend.dev, which only delivers to your Resend account's
# own address. Name the farm in the sender, so a team with several farms can
# tell which one it is. Comma-separate several recipients.
#RESEND_API_KEY=
#ALERT_EMAIL_FROM="North Farm <onboarding@resend.dev>"
#ALERT_EMAIL_TO=
