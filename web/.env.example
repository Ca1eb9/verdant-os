# Copy to web/.env.local for `npm run dev` (Next only reads env files in web/).
# On the Pi the dashboard uses /etc/verdant/dashboard.env instead
# (deploy/env/dashboard.env.example); on Vercel, its environment variables
# (docs/SUPABASE-SETUP.md). NEXT_PUBLIC_* values are fixed at build time:
# restart `npm run dev` after changing them.

# Supabase: the farm list and, remotely, readings and commands
# (docs/SUPABASE-SETUP.md). The publishable key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The dashboard picks its source from how it's opened: over http (the Pi, or
# `npm run dev`) it's FarmNet and connects to the broker on port 9001 of the
# same host; over https (Vercel, or `npm run dev -- --experimental-https`) it
# reads the farm from Supabase.
# On the farm network only; leave these unset on Vercel.
# This Pi's farm: its row in Supabase's farms table. Lowercase letters,
# digits and dashes. Set, it also turns off operator sign-in (as on a Pi).
# Set it for `npm run dev` on FarmNet: without it the dashboard asks you to
# sign in and says it isn't set up for a farm.
NEXT_PUBLIC_FARM_ID=
NEXT_PUBLIC_FARM_NAME=
# The Dashboard API: command history and other stored data. Unset: those
# lists start empty and fill live.
NEXT_PUBLIC_DASHBOARD_API_URL=
# true: offer jog before a robot has read its first tag (initializing), e.g.
# to drive it onto one. Off unless set.
NEXT_PUBLIC_JOG_WHILE_INITIALIZING=false

# Operator sign-in (Supabase Auth, docs/SUPABASE-SETUP.md step 6) is on
# wherever NEXT_PUBLIC_FARM_ID is unset, as on Vercel; never on a farm's Pi.
# true turns it off (redeploy after changing it on Vercel). Server-side only.
#AUTH_DISABLED=true

# Remote commands (server-side only, as on Vercel). With sign-in on, the
# operator's session authorizes them; with it off, OPERATOR_KEY does. The
# secret key is always needed, else they're turned off. Never commit real values.
#OPERATOR_KEY=
#SUPABASE_SERVICE_ROLE_KEY=
