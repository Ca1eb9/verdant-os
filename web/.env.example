# Copy to web/.env.local for `npm run dev` (Next only reads env files in web/).
# On the Pi the dashboard uses /etc/verdant/dashboard.env instead
# (deploy/env/dashboard.env.example); on Vercel, its environment variables
# (docs/SUPABASE-SETUP.md). NEXT_PUBLIC_* values are fixed at build time:
# restart `npm run dev` after changing them.

# Supabase: farm data remotely, and history (docs/SUPABASE-SETUP.md). The
# publishable key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# On the farm network only; leave these unset on Vercel.
# The broker's WebSocket listener (farm-controller/README.md)
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
# This Pi's farm: its row in Supabase's farms table. Lowercase letters,
# digits and dashes.
NEXT_PUBLIC_FARM_ID=
NEXT_PUBLIC_FARM_NAME=
# The Dashboard API: command history and other stored data. Unset: those
# lists start empty and fill live.
NEXT_PUBLIC_DASHBOARD_API_URL=
# true: offer jog before a robot has read its first tag (initializing), e.g.
# to drive it onto one. Off unless set.
NEXT_PUBLIC_JOG_WHILE_INITIALIZING=false

# Remote commands (server-side only, as on Vercel): both needed, else they're
# turned off. Never commit real values.
#OPERATOR_KEY=
#SUPABASE_SERVICE_ROLE_KEY=
